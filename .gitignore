# ==========================================
# Root-level / Global IDE & System Files
# ==========================================
.vscode/
.idea/
*.iws
*.iml
*.ipr
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Java / Maven (Spring Boot)
# ==========================================
**/target/
**/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear

# ==========================================
# JavaScript / Node (React / Vite)
# ==========================================
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# ==========================================
# Environment Variables & Sensitive Files
# ==========================================
**/.env
**/.env.local
**/.env.*.local

# ==========================================
# Project Specific Runtime / Cache Data
# ==========================================
**/cache-service/data/
**/cache-snapshot.json

# ==========================================
# Python / Virtualenv / Pytest
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.pytest_cache
.coverage
htmlcov/
venv/
.venv/
env/
ENV/

# ==========================================
# Private / Candidate Prep Notes & Temp Folders
# ==========================================
interview-answers.txt
Distributed-Self-Healing-Cache-Platform/
