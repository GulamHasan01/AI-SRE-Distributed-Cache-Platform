# ============================================================
# AI-SRE-Distributed-Cache-Platform Environment Configuration
# ============================================================

# LLM API Keys (Optional — Agent has deterministic expert fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# MCP Server
MCP_SERVER_URL=http://localhost:8000
MCP_SERVER_NAME=sre-cluster-mcp
MCP_SERVER_VERSION=1.0.0

# SRE Agent
AGENT_API_PORT=9090
APPROVAL_TIMEOUT_SECONDS=120
VERIFICATION_WAIT_SECONDS=15
INCIDENTS_DIR=./incidents

# Monitoring & Prometheus
PROMETHEUS_URL=http://localhost:9091

# Cache Cluster Services
CACHE_NODE_1_URL=http://localhost:8081
CACHE_NODE_2_URL=http://localhost:8082
CACHE_NODE_3_URL=http://localhost:8083
GATEWAY_URL=http://localhost:8080

# Security & Permissions
ALLOWED_NODE_IDS=node-1,node-2,node-3
ALLOWED_CONTAINER_NAMES=cache-node-1,cache-node-2,cache-node-3
CHAOS_ENABLED=true
CACHE_CHAOS_ENABLED=true

# Audit Logs
AUDIT_LOG_PATH=./audit/audit_log.jsonl
